{margin: 0;
padding: 0
box-sizing: border-box
}
body{
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f6f9;
}
.navbar {
    height; 60px;
    background-color: #0f1111;
    color: white;
    display: flex;
    align-items: center;
    justifiy-content: space-evenly;
}
.logo {
    font-size: 25px;
    font-weight: bold;
    color: #ff9909;
}
.navlink {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
}
.navlink a {
    text-decoration: none;
    color: white;
    font-size: 16px;

}
.nav-link a:hover{
    color: #ff9900
}
.search-bar {
    display:  flex;
    align-items: center;
    height: 35px;

}
.search-bar input {
    width: 200px;
    height: 35px;
    padding: 8px;
    border: none;
    outline: none;
    font-size: 14px;
}
>.search-bar button {
    height: 35px;
    padding: 0 12px;
    border: none;
    background-color: #febd69;
    cursor: pointer;
    border-radius: 0%;
}
